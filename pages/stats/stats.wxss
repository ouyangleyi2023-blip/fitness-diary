.tabs {
  display: flex; background: var(--surface-2); border-radius: 999rpx; padding: 6rpx; margin-bottom: 24rpx;
}
.tab { flex: 1; text-align: center; height: 68rpx; line-height: 68rpx; font-size: 28rpx; color: var(--text-2); border-radius: 999rpx; }
.tab.on { background: rgba(255,107,53,.16); color: var(--brand); font-weight: 600; }

.kpi { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.kpi-item {
  width: 50%; box-sizing: border-box; padding: 24rpx 8rpx; margin-bottom: 16rpx;
}
.kpi-item:nth-child(odd) { padding-right: 16rpx; }
.kpi-item:nth-child(even) { padding-left: 16rpx; }
.kpi-item {
  background: var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx;
  text-align: center; width: calc(50% - 16rpx); margin: 8rpx;
}
.kpi-n { display: block; font-size: 48rpx; font-weight: 700; color: var(--brand); font-variant-numeric: tabular-nums; }
.kpi-l { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--text-3); }
.kpi-sub { text-align: center; font-size: 24rpx; color: var(--text-2); margin-bottom: 28rpx; }

.chart { display: flex; align-items: flex-end; justify-content: space-between; height: 260rpx; padding-top: 8rpx; }
.chart-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.chart-val { font-size: 18rpx; color: var(--text-3); margin-bottom: 6rpx; }
.chart-bar {
  width: 60%; min-width: 12rpx; border-radius: 8rpx 8rpx 3rpx 3rpx; background: var(--surface-2);
}
.chart-bar.on { background: linear-gradient(180deg, #FF7A3C, #FF4D2E); }
.chart-label { margin-top: 10rpx; font-size: 18rpx; color: var(--text-3); }

.part-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.part-row:last-child { margin-bottom: 0; }
.part-name { width: 130rpx; display: flex; align-items: center; font-size: 26rpx; flex-shrink: 0; }
.part-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 12rpx; }
.part-bar { flex: 1; height: 14rpx; background: var(--surface-2); border-radius: 999rpx; overflow: hidden; margin: 0 16rpx; }
.part-bar-in { height: 100%; border-radius: 999rpx; transition: width .3s; }
.part-val { width: 60rpx; text-align: right; font-size: 26rpx; color: var(--text-2); }

.month-nav { display: flex; align-items: center; }
.mn { padding: 0 16rpx; font-size: 34rpx; color: var(--text-2); }
.mlabel { font-size: 26rpx; color: var(--text-2); min-width: 150rpx; text-align: center; }

.cal-head { display: flex; margin-bottom: 12rpx; }
.cal-head text { flex: 1; text-align: center; font-size: 22rpx; color: var(--text-3); }
.cal { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%; height: 72rpx; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--text-2); margin-bottom: 6rpx;
}
.cal-cell > text { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 12rpx; }
.cal-cell.blank { visibility: hidden; }
.cal-cell.lv1 > text { background: rgba(255,107,53,.22); color: var(--brand); }
.cal-cell.lv2 > text { background: rgba(255,107,53,.48); color: #fff; }
.cal-cell.lv3 > text { background: linear-gradient(135deg, #FF7A3C, #FF4D2E); color: #fff; font-weight: 600; }

.cal-legend { display: flex; justify-content: space-between; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.lg { display: flex; align-items: center; font-size: 20rpx; color: var(--text-3); }
.lg-box { width: 18rpx; height: 18rpx; border-radius: 4rpx; background: var(--surface-2); margin-right: 8rpx; }
.lg-box.lv1 { background: rgba(255,107,53,.22); }
.lg-box.lv2 { background: rgba(255,107,53,.48); }
.lg-box.lv3 { background: #FF6B35; }
