.me { display: flex; align-items: center; }
.me-avatar {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #FF7A3C, #FF4D2E);
  color: #fff; font-size: 44rpx; font-weight: 700; text-align: center; line-height: 96rpx;
}
.me-info { margin-left: 24rpx; flex: 1; min-width: 0; }
.me-name { font-size: 36rpx; font-weight: 700; }
.me-sub { margin-top: 6rpx; font-size: 24rpx; color: var(--text-2); }

.kpi3 { display: flex; margin-bottom: 24rpx; }
.k3 {
  flex: 1; background: var(--surface); border: 1rpx solid var(--line); border-radius: 20rpx;
  text-align: center; padding: 20rpx 0; margin-right: 12rpx;
}
.k3:last-child { margin-right: 0; }
.k3-n { display: block; font-size: 40rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.k3-l { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--text-3); }

.form-row { display: flex; align-items: center; min-height: 64rpx; }
.form-label { width: 150rpx; font-size: 28rpx; color: var(--text-2); flex-shrink: 0; }
.form-input { flex: 1; font-size: 30rpx; text-align: right; }
.form-unit { padding-left: 10rpx; font-size: 26rpx; color: var(--text-3); }
.ph { color: var(--text-3); }

.chips { flex: 1; display: flex; justify-content: flex-end; flex-wrap: wrap; }
.chip {
  padding: 8rpx 22rpx; margin: 4rpx 0 4rpx 12rpx; border-radius: 999rpx;
  background: var(--surface-2); font-size: 26rpx; color: var(--text-2);
}
.chip.on { background: rgba(255,107,53,.16); color: var(--brand); font-weight: 600; }

.cell { display: flex; align-items: center; padding: 8rpx 0; }
.cell-t { flex: 1; font-size: 30rpx; }
.cell-v { font-size: 26rpx; color: var(--text-2); }
.cell-a { margin-left: 12rpx; font-size: 32rpx; color: var(--text-3); }
.danger { border-color: rgba(255,77,46,.25); }
.danger-t { color: #FF5A5A; }

.foot { text-align: center; font-size: 22rpx; color: var(--text-3); padding: 24rpx 0; }

/* ---- v2 追加 ---- */
.me-edit {
  padding: 8rpx 24rpx; height: 52rpx; line-height: 52rpx; border-radius: 26rpx;
  background: rgba(255,107,53,.14); color: var(--brand); font-size: 24rpx;
}
.chip.wd { min-width: 76rpx; text-align: center; }
.form-input.sm { width: 120rpx; text-align: center; }
.form-row switch { transform: scale(.8); }

/* ---- 弹层 ---- */
.mask {
  position: fixed; inset: 0; background: rgba(0,0,0,.55); opacity: 0;
  visibility: hidden; transition: all .25s; z-index: 30;
}
.mask.on { opacity: 1; visibility: visible; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 31;
  background: var(--surface, #15181F); border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); transition: transform .28s;
  display: flex; flex-direction: column; max-height: 82vh;
}
.sheet.on { transform: translateY(0); }
.sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.sheet-title { font-size: 32rpx; font-weight: 600; }
.sheet-close { font-size: 26rpx; color: var(--text-3); padding: 8rpx 4rpx; }

.preset-scroll { white-space: nowrap; margin-bottom: 16rpx; }
.preset-in { display: inline-flex; gap: 12rpx; }
.part-chip {
  display: inline-block; padding: 10rpx 30rpx; border-radius: 999rpx;
  background: var(--surface-2, #1C2029); color: var(--text-2, #C6CBD4); font-size: 26rpx;
}
.part-chip.on { background: rgba(255,107,53,.16); color: var(--brand); }

.tpl-list { flex: 1; overflow-y: auto; min-height: 120rpx; }
.tpl-row { display: flex; align-items: center; padding: 20rpx 4rpx; border-bottom: 1rpx solid var(--line); }
.tpl-rname { flex: 1; font-size: 28rpx; }
.tpl-rsub { font-size: 22rpx; color: var(--text-3); margin-right: 20rpx; }
.tpl-rdel { font-size: 36rpx; color: var(--text-3); padding: 0 10rpx; }

.search-row { display: flex; align-items: center; margin-top: 16rpx; }
.search-input { flex: 1; height: 72rpx; background: var(--surface-2, #1C2029); border-radius: 14rpx; padding: 0 20rpx; font-size: 26rpx; }
.custom-input.sm2 { width: 110rpx; height: 72rpx; background: var(--surface-2, #1C2029); border-radius: 14rpx; padding: 0 12rpx; font-size: 26rpx; margin-left: 10rpx; text-align: center; }
.custom-add {
  margin-left: 10rpx; padding: 0 24rpx; height: 72rpx; line-height: 72rpx;
  border-radius: 14rpx; background: rgba(255,107,53,.16); color: var(--brand); font-size: 26rpx;
}
.tpl-ops { display: flex; gap: 16rpx; margin-top: 22rpx; }
.tpl-save {
  flex: 1; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx;
  background: var(--brand, #FF6B35); color: #fff; font-size: 30rpx; font-weight: 600;
}
.tpl-del {
  width: 240rpx; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx;
  background: rgba(255,77,46,.12); color: #FF4D2E; font-size: 28rpx;
}
.pick-empty { padding: 50rpx 0; text-align: center; color: var(--text-3); font-size: 26rpx; }
