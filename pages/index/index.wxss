.hero { padding: 8rpx 4rpx 28rpx; }
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.hero-hi { font-size: 40rpx; font-weight: 700; }
.hero-date { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }
.hero-badge {
  background: linear-gradient(135deg, rgba(255,122,60,.18), rgba(255,77,46,.10));
  border: 1rpx solid rgba(255,107,53,.3);
  border-radius: 20rpx; padding: 12rpx 24rpx; text-align: center;
}
.hero-badge-num { display: block; font-size: 40rpx; font-weight: 700; color: var(--brand); line-height: 1.1; }
.hero-badge-txt { display: block; font-size: 20rpx; color: var(--text-2); }

.status { display: flex; align-items: center; justify-content: space-between; }
.status.done { border-color: rgba(45,212,167,.35); background: linear-gradient(135deg, rgba(45,212,167,.10), rgba(23,26,33,.9)); }
.status-title { font-size: 34rpx; font-weight: 600; }
.status-sub { margin-top: 6rpx; font-size: 24rpx; color: var(--text-2); }
.status-btn {
  padding: 0 32rpx; height: 64rpx; line-height: 64rpx; border-radius: 999rpx;
  background: var(--brand); color: #fff; font-size: 26rpx; font-weight: 600; flex-shrink: 0;
}
.status.done .status-btn { background: rgba(255,255,255,.08); color: var(--text-2); }

.progress { height: 14rpx; background: var(--surface-2); border-radius: 999rpx; overflow: hidden; }
.progress-in { height: 100%; background: linear-gradient(90deg, #FF7A3C, #FF4D2E); border-radius: 999rpx; transition: width .3s; }
.progress-tip { margin-top: 14rpx; font-size: 24rpx; color: var(--text-2); }

.ex-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.ex-item:last-child { border-bottom: 0; }
.ex-dot { width: 10rpx; height: 44rpx; border-radius: 6rpx; margin-right: 20rpx; flex-shrink: 0; }
.ex-main { flex: 1; min-width: 0; }
.ex-name { font-size: 30rpx; font-weight: 500; }
.ex-sets { margin-top: 4rpx; font-size: 24rpx; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ex-right { text-align: right; flex-shrink: 0; margin-left: 16rpx; }
.ex-vol { display: block; font-size: 28rpx; font-weight: 600; color: var(--brand); }
.ex-cnt { display: block; font-size: 22rpx; color: var(--text-3); }
.ex-note { margin-top: 16rpx; font-size: 24rpx; color: var(--text-2); }

.go-btn { margin: 8rpx 0 32rpx; }

.week { display: flex; align-items: flex-end; justify-content: space-between; padding-top: 8rpx; }
.week-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.week-bar {
  width: 40rpx; border-radius: 10rpx 10rpx 4rpx 4rpx; background: var(--surface-2);
  min-height: 8rpx;
}
.week-bar.on { background: linear-gradient(180deg, #FF7A3C, #FF4D2E); }
.week-bar.today { box-shadow: 0 0 0 2rpx rgba(255,107,53,.35); }
.week-label { margin-top: 12rpx; font-size: 22rpx; color: var(--text-3); }
.week-label.on { color: var(--brand); font-weight: 600; }

.weight-input-wrap { display: flex; align-items: center; }
.weight-input {
  flex: 1; height: 80rpx; background: var(--surface-2); border-radius: 16rpx;
  padding: 0 24rpx; font-size: 40rpx; font-weight: 600; color: var(--text);
}
.ph { color: var(--text-3); font-size: 28rpx; font-weight: 400; }
.weight-unit { padding: 0 20rpx; font-size: 28rpx; color: var(--text-2); }
.weight-save {
  padding: 0 28rpx; height: 72rpx; line-height: 72rpx; border-radius: 16rpx;
  background: rgba(255,107,53,.16); color: var(--brand); font-size: 28rpx; font-weight: 600;
}
.weight-tip { margin-top: 18rpx; font-size: 24rpx; color: var(--text-2); }
.up { color: #FF6B6B; }
.down { color: #2DD4A7; }
