.wt-top { display: flex; align-items: flex-end; justify-content: space-between; }
.wt-n { font-size: 64rpx; font-weight: 700; color: var(--brand); font-variant-numeric: tabular-nums; }
.wt-u { font-size: 26rpx; color: var(--text-2); margin-left: 8rpx; }
.wt-delta { font-size: 24rpx; color: var(--text-2); }

.chart { width: 100%; height: 320rpx; margin: 16rpx 0 8rpx; }

.wt-stats { display: flex; border-top: 1rpx solid var(--line); padding-top: 18rpx; }
.ws { flex: 1; text-align: center; }
.ws-n { display: block; font-size: 32rpx; font-weight: 600; }
.ws-l { display: block; margin-top: 2rpx; font-size: 22rpx; color: var(--text-3); }

.weight-input-wrap { display: flex; align-items: center; }
.weight-input {
  flex: 1; height: 80rpx; background: var(--surface-2); border-radius: 16rpx;
  padding: 0 24rpx; font-size: 34rpx; font-weight: 600; color: var(--text);
}
.ph { color: var(--text-3); font-size: 26rpx; font-weight: 400; }
.weight-unit { padding: 0 20rpx; font-size: 28rpx; color: var(--text-2); }
.weight-save {
  padding: 0 28rpx; height: 72rpx; line-height: 72rpx; border-radius: 16rpx;
  background: rgba(255,107,53,.16); color: var(--brand); font-size: 28rpx; font-weight: 600;
}

.wrow { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.wrow:last-child { border-bottom: 0; }
.wr-date { flex: 1; font-size: 28rpx; color: var(--text-2); }
.wr-kg { width: 130rpx; text-align: right; font-size: 30rpx; font-weight: 600; }
.wr-delta { width: 110rpx; text-align: right; font-size: 24rpx; color: var(--text-3); }
.wr-del { width: 90rpx; text-align: right; font-size: 24rpx; color: var(--text-3); }
.up { color: #FF6B6B; }
.down { color: #2DD4A7; }
