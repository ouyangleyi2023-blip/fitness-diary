page {
  --bg: #0F1115;
  --surface: #171A21;
  --surface-2: #1E222B;
  --line: #262B35;
  --text: #EDEFF5;
  --text-2: #9AA1AF;
  --text-3: #6B7280;
  --brand: #FF6B35;
  --brand-2: #FF9A3C;
  --ok: #2DD4A7;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* 区块标题 */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 4rpx 20rpx;
}
.sec-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.sec-more {
  font-size: 24rpx;
  color: var(--text-2);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF7A3C, #FF4D2E);
  color: #fff;
  border-radius: 999rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 40, .28);
}
.btn-primary.ghost {
  background: transparent;
  color: var(--brand);
  border: 2rpx solid rgba(255, 107, 53, .45);
  box-shadow: none;
}
.btn-primary.plain {
  background: var(--surface-2);
  color: var(--text-2);
  box-shadow: none;
}

/* 小标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: rgba(255, 107, 53, .14);
  color: var(--brand);
}

.empty {
  padding: 48rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.row {
  display: flex;
  align-items: center;
}

.num-lg {
  font-size: 56rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}
