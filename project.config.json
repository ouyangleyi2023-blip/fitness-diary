  "packOptions": {
    "ignore": [
      { "type": "file", "value": "tools_gen_icons.py" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": "DEPLOY.md" },
      { "type": "folder", "value": "preview" }
    ],
    "include": []
  },
  "condition": {}
}
